    top: 12%;
    background: radial-gradient(circle, rgba(255, 206, 153, 0.22), transparent 70%);
    animation: wedding-card-float-{{ section.id }} 11s ease-in-out infinite alternate-reverse;
  }

  #wedding-card-{{ section.id }} .wedding-card__curtain {
    position: absolute;
    top: 0;
    width: 50.5%;
    height: 100%;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--curtain-base) 74%, #180005 26%), var(--curtain-base) 40%, color-mix(in srgb, var(--curtain-shadow) 72%, #000 28%)),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.1) 0 16px, rgba(0,0,0,0.08) 16px 32px);
    box-shadow: inset -12px 0 28px rgba(0, 0, 0, 0.35);
    animation-duration: 2.4s;
    animation-delay: .25s;
    animation-fill-mode: forwards;
    animation-timing-function: cubic-bezier(.77, 0, .18, 1);
  }

  #wedding-card-{{ section.id }} .wedding-card__curtain::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255,255,255,0.2), transparent 24%, transparent 74%, rgba(0,0,0,0.22));
  }

  #wedding-card-{{ section.id }} .wedding-card__curtain--left {
    left: 0;
    animation-name: wedding-card-open-left-{{ section.id }};
  }

  #wedding-card-{{ section.id }} .wedding-card__curtain--right {
    right: 0;
    box-shadow: inset 12px 0 28px rgba(0, 0, 0, 0.35);
    animation-name: wedding-card-open-right-{{ section.id }};
  }

  #wedding-card-{{ section.id }} .wedding-card__spotlight {
    inset: auto 50% 18%;
    width: min(90vw, 980px);
    height: min(72vh, 720px);
    transform: translateX(-50%);
    background:
      radial-gradient(circle at center, rgba(255, 236, 194, 0.28), rgba(255, 236, 194, 0.1) 28%, transparent 62%);
    filter: blur(4px);
  }

  #wedding-card-{{ section.id }} .wedding-card__spotlight::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -16%;
    width: 62%;
    height: 78%;
    transform: translateX(-50%);
    background: linear-gradient(180deg, rgba(255, 250, 230, 0.32), transparent 74%);
    clip-path: polygon(47% 0, 53% 0, 100% 100%, 0 100%);
    filter: blur(12px);
    opacity: .9;
  }

  #wedding-card-{{ section.id }} .wedding-card__stage {
    inset: auto 50% 0;
    width: min(1000px, 92vw);
    height: 30vh;
    transform: translateX(-50%);
    background: radial-gradient(circle at center, rgba(255, 220, 168, 0.38), rgba(255, 220, 168, 0.08) 35%, transparent 74%);
  }

  #wedding-card-{{ section.id }} .wedding-card__petal {
    position: absolute;
    top: -12vh;
    left: var(--left);
    width: var(--size);
    height: calc(var(--size) * .74);
    border-radius: 70% 0 70% 0;
    opacity: 0;
    background:
      radial-gradient(circle at 30% 30%, rgba(255,255,255,.9), rgba(255,255,255,.18) 24%, transparent 38%),
      linear-gradient(135deg, var(--petal-start), var(--petal-end));
    box-shadow: 0 0 16px rgba(255, 96, 149, 0.2);
    animation: wedding-card-petal-fall-{{ section.id }} var(--duration) linear forwards;
    animation-delay: var(--delay);
  }

  #wedding-card-{{ section.id }} .wedding-card__characters {
    inset: auto 0 0;
    height: min(58vh, 600px);
  }

  #wedding-card-{{ section.id }} .wedding-card__character {
    position: absolute;
    bottom: 0;
    width: clamp(180px, 22vw, 300px);
    aspect-ratio: 0.66;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    filter: drop-shadow(0 26px 36px rgba(0,0,0,.38));
    animation-duration: 2.35s;
    animation-delay: 1.05s;
    animation-fill-mode: forwards;
    animation-timing-function: cubic-bezier(.2, .8, .2, 1);
    opacity: 0;
  }

  #wedding-card-{{ section.id }} .wedding-card__character::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 2%;
    width: 76%;
    height: 12%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(0,0,0,.38), transparent 70%);
    filter: blur(10px);
    z-index: -1;
  }

  #wedding-card-{{ section.id }} .wedding-card__character--bride {
    left: clamp(4%, 8vw, 15%);
    transform: translateX(-80vw) scale(.92);
    animation-name: wedding-card-bride-in-{{ section.id }};
  }

  #wedding-card-{{ section.id }} .wedding-card__character--groom {
    right: clamp(4%, 8vw, 15%);
    transform: translateX(80vw) scale(.92);
    animation-name: wedding-card-groom-in-{{ section.id }};
  }

  #wedding-card-{{ section.id }} .wedding-card__character-image,
  #wedding-card-{{ section.id }} .wedding-card__character-placeholder {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
  }

  #wedding-card-{{ section.id }} .wedding-card__character-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 28px;
    border: 1px dashed rgba(255,255,255,.28);
    background: rgba(255,255,255,.08);
    color: var(--text-soft);
    font-size: 1.1rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  #wedding-card-{{ section.id }} .wedding-card__content {
    position: relative;
    z-index: 2;
