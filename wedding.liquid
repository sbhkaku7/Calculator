  }

  #wedding-card-{{ section.id }} *,
  #wedding-card-{{ section.id }} *::before,
  #wedding-card-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #wedding-card-{{ section.id }} .wedding-card__scene {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 3vw, 40px);
  }

  #wedding-card-{{ section.id }} .wedding-card__backdrop,
  #wedding-card-{{ section.id }} .wedding-card__spotlight,
  #wedding-card-{{ section.id }} .wedding-card__stage,
  #wedding-card-{{ section.id }} .wedding-card__petals,
