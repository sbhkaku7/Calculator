    0% {
      opacity: 0;
      transform: translate3d(0, -8vh, 0) rotate(0deg) scale(.86);
    }
    10% {
      opacity: .92;
    }
    50% {
      transform: translate3d(calc(var(--drift) * .55), 50vh, 0) rotate(calc(var(--spin) * .55)) scale(1);
    }
    100% {
      opacity: 0;
      transform: translate3d(var(--drift), 118vh, 0) rotate(var(--spin)) scale(1.08);
    }
  }

  @keyframes wedding-card-float-{{ section.id }} {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(18px, -22px, 0) scale(1.06); }
