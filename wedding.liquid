    font-weight: 600;
  }

  #wedding-card-{{ section.id }} .wedding-card__title {
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    line-height: .94;
    color: var(--text-main);
    font-family: Georgia, "Times New Roman", serif;
    text-shadow: 0 0 20px rgba(255, 228, 174, .18);
  }

  #wedding-card-{{ section.id }} .wedding-card__title span {
    color: var(--accent);
    font-size: .82em;
  }

  #wedding-card-{{ section.id }} .wedding-card__divider {
    width: 120px;
    height: 1px;
    margin: 18px auto 22px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    position: relative;
  }

  #wedding-card-{{ section.id }} .wedding-card__divider::after {
    content: "◆";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 0 10px;
    color: var(--accent);
    background: transparent;
  }

  #wedding-card-{{ section.id }} .wedding-card__message {
    color: var(--text-soft);
    font-size: clamp(1rem, 2vw, 1.1rem);
    line-height: 1.8;
    margin: 0 auto 14px;
    max-width: 34ch;
  }

  #wedding-card-{{ section.id }} .wedding-card__message p {
    margin: 0;
  }

  #wedding-card-{{ section.id }} .wedding-card__date {
    margin: 0 0 24px;
    font-size: .92rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text-main) 72%, transparent 28%);
  }

  #wedding-card-{{ section.id }} .wedding-card__actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  #wedding-card-{{ section.id }} .wedding-card__button {
    appearance: none;
    border: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 190px;
    padding: 14px 22px;
    border-radius: 999px;
    text-decoration: none;
    font-size: .95rem;
    font-weight: 600;
    transition: transform .3s ease, box-shadow .3s ease, background .3s ease;
  }

  #wedding-card-{{ section.id }} .wedding-card__button:hover {
    transform: translateY(-3px) scale(1.015);
  }

  #wedding-card-{{ section.id }} .wedding-card__button--hidden,
  #wedding-card-{{ section.id }} .wedding-card__date--hidden {
    display: none;
  }

  #wedding-card-{{ section.id }} .wedding-card__button--primary {
    color: #2d0d12;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    box-shadow: 0 14px 30px rgba(255, 203, 116, .26);
  }

  #wedding-card-{{ section.id }} .wedding-card__button--ghost {
    color: var(--text-main);
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.12);
  }

  #wedding-card-{{ section.id }} .wedding-card__footer {
    margin: 22px 0 0;
    color: color-mix(in srgb, var(--text-main) 60%, transparent 40%);
    font-size: .82rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  @keyframes wedding-card-open-left-{{ section.id }} {
    to { transform: translateX(-108%); }
  }

  @keyframes wedding-card-open-right-{{ section.id }} {
    to { transform: translateX(108%); }
  }

  @keyframes wedding-card-bride-in-{{ section.id }} {
    0% { opacity: 0; transform: translateX(-80vw) scale(.92); }
    70% { opacity: 1; }
    100% { opacity: 1; transform: translateX(min(16vw, 120px)) scale(1); }
  }

  @keyframes wedding-card-groom-in-{{ section.id }} {
    0% { opacity: 0; transform: translateX(80vw) scale(.92); }
    70% { opacity: 1; }
    100% { opacity: 1; transform: translateX(max(-16vw, -120px)) scale(1); }
  }

  @keyframes wedding-card-content-in-{{ section.id }} {
    0% { opacity: 0; transform: translateY(40px) scale(.96); filter: blur(10px); }
    100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
  }

  @keyframes wedding-card-petal-fall-{{ section.id }} {
    0% {
      opacity: 0;
      transform: translate3d(0, -8vh, 0) rotate(0deg) scale(.86);
    }
    10% {
      opacity: .92;
    }
    50% {
      transform: translate3d(calc(var(--drift) * .55), 50vh, 0) rotate(calc(var(--spin) * .55)) scale(1);
    }
    100% {
      opacity: 0;
      transform: translate3d(var(--drift), 118vh, 0) rotate(var(--spin)) scale(1.08);
    }
  }

  @keyframes wedding-card-float-{{ section.id }} {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(18px, -22px, 0) scale(1.06); }
  }

  @media screen and (max-width: 989px) {
    #wedding-card-{{ section.id }} .wedding-card__characters {
      height: min(48vh, 480px);
    }

    #wedding-card-{{ section.id }} .wedding-card__character {
      width: clamp(150px, 28vw, 240px);
    }

    #wedding-card-{{ section.id }} .wedding-card__character--bride {
      left: 2%;
    }

    #wedding-card-{{ section.id }} .wedding-card__character--groom {
      right: 2%;
    }
  }

  @media screen and (max-width: 749px) {
    #wedding-card-{{ section.id }} .wedding-card__scene {
      align-items: flex-start;
      padding-top: 40px;
      padding-bottom: 180px;
    }

    #wedding-card-{{ section.id }} .wedding-card__content {
      width: min(94vw, 480px);
      padding: 26px 18px;
    }

    #wedding-card-{{ section.id }} .wedding-card__characters {
      height: min(38vh, 330px);
    }

    #wedding-card-{{ section.id }} .wedding-card__character {
      width: clamp(120px, 32vw, 180px);
    }

    #wedding-card-{{ section.id }} .wedding-card__actions {
      flex-direction: column;
    }

    #wedding-card-{{ section.id }} .wedding-card__button {
      width: 100%;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('wedding-card-{{ section.id }}');
    if (!root) return;

    const petalsHost = root.querySelector('[data-petals]');
    const replayButton = root.querySelector('[data-replay]');
    const namesEl = root.querySelector('[data-names]');
    const messageEl = root.querySelector('[data-message]');
    const dateEl = root.querySelector('[data-date]');
    const locationEl = root.querySelector('[data-location]');
    const locationLabelEl = root.querySelector('[data-location-label]');
    const params = new URLSearchParams(window.location.search);
    let petalInterval;

    function decodeMessage(value) {
      if (!value) return '';
      try {
        return window.atob(value);
      } catch (error) {
        return value;
      }
    }

    function hydrateFromUrl() {
      const brideName = params.get('b') || root.dataset.brideName || '';
      const groomName = params.get('g') || root.dataset.groomName || '';
      const weddingDate = params.get('d') || root.dataset.weddingDate || '';
      const dateLabel = root.dataset.dateLabel || 'Wedding Date:';
      const locationUrl = params.get('l') || root.dataset.locationUrl || '';
      const locationLabel = params.get('ll') || root.dataset.locationLabel || 'View Location';
      const customMessage = decodeMessage(params.get('m')) || messageEl?.textContent?.trim() || '';

      if (namesEl) {
        namesEl.innerHTML = `${brideName} <span>♥</span> ${groomName}`.trim();
      }

      if (messageEl && customMessage) {
        const messageParagraph = messageEl.querySelector('p') || document.createElement('p');
        messageParagraph.textContent = customMessage;
        if (!messageParagraph.parentNode) messageEl.appendChild(messageParagraph);
      }

      if (dateEl) {
        const hasDate = Boolean(weddingDate);
        dateEl.textContent = hasDate ? `${dateLabel} ${weddingDate}` : '';
        dateEl.style.display = hasDate ? '' : 'none';
        dateEl.classList.toggle('wedding-card__date--hidden', !hasDate);
      }

      if (locationEl && locationLabelEl) {
        if (locationUrl) {
          locationEl.href = locationUrl;
          locationEl.style.display = '';
          locationEl.classList.remove('wedding-card__button--hidden');
          locationLabelEl.textContent = locationLabel;
        } else {
          locationEl.style.display = 'none';
          locationEl.classList.add('wedding-card__button--hidden');
        }
      }
    }

    function createPetal() {
      const petal = document.createElement('span');
      petal.className = 'wedding-card__petal';
      petal.style.setProperty('--left', `${Math.random() * 100}%`);
      petal.style.setProperty('--size', `${12 + Math.random() * 16}px`);
      petal.style.setProperty('--duration', `${5.2 + Math.random() * 2.8}s`);
      petal.style.setProperty('--delay', `${Math.random() * 0.4}s`);
      petal.style.setProperty('--drift', `${-160 + Math.random() * 320}px`);
      petal.style.setProperty('--spin', `${-220 + Math.random() * 440}deg`);
      petalsHost.appendChild(petal);
      window.setTimeout(() => petal.remove(), 9000);
    }

    function startPetals() {
      window.clearInterval(petalInterval);
      petalsHost.innerHTML = '';

      for (let i = 0; i < 20; i += 1) {
        window.setTimeout(createPetal, i * 110);
      }

      petalInterval = window.setInterval(() => {
        createPetal();
        if (Math.random() > 0.45) createPetal();
      }, 180);
    }

    function replayCssAnimation(element) {
      if (!element) return;
      element.style.animation = 'none';
      void element.offsetWidth;
      element.style.animation = '';
    }

    function restartAnimations() {
      root.querySelectorAll('.wedding-card__curtain, .wedding-card__character, .wedding-card__content').forEach(replayCssAnimation);
      startPetals();
    }

    hydrateFromUrl();
    replayButton?.addEventListener('click', restartAnimations);
    startPetals();
  })();
</script>
