<section
  id="wedding-card-{{ section.id }}"
  class="wedding-card-section wedding-card-section--{{ section.id }}"
  data-bride-name="{{ section.settings.bride_name | escape }}"
  data-groom-name="{{ section.settings.groom_name | escape }}"
  data-date-label="{{ section.settings.date_label | escape }}"
  data-wedding-date="{{ section.settings.wedding_date | escape }}"
  data-location-label="{{ section.settings.location_label | escape }}"
  data-location-url="{{ section.settings.location_url | escape }}"
  data-inviter-name="{{ section.settings.inviter_name | escape }}"
>
  <div class="wedding-card__intro" data-intro>
    <p class="wedding-card__intro-kicker">You're invited</p>
    <h2 class="wedding-card__intro-title"><span data-inviter>{{ section.settings.inviter_name }}</span> invites you to a wedding</h2>
    <button class="wedding-card__button wedding-card__button--primary" type="button" data-open-invitation>{{ section.settings.open_button_label }}</button>
  </div>

  <div class="wedding-card__curtains" aria-hidden="true">
    <div class="wedding-card__curtain wedding-card__curtain--left"></div>
    <div class="wedding-card__curtain wedding-card__curtain--right"></div>
  </div>

  <div class="wedding-card__scene" data-scene>
    <div class="wedding-card__backdrop" aria-hidden="true"></div>
   <canvas class="wedding-card__particles" data-particles aria-hidden="true"></canvas>
    <div class="wedding-card__spotlight" aria-hidden="true"></div>
    <div class="wedding-card__stage" aria-hidden="true"></div>
    <div class="wedding-card__petals" data-petals></div>

    <div class="wedding-card__characters" aria-hidden="true">
      <div class="wedding-card__character wedding-card__character--bride">
        {% if section.settings.bride_image != blank %}
          {{ section.settings.bride_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'wedding-card__character-image', alt: section.settings.bride_name | escape }}
        {% else %}
          <div class="wedding-card__character-placeholder">Bride</div>
        {% endif %}
      </div>
      <div class="wedding-card__character wedding-card__character--groom">
        {% if section.settings.groom_image != blank %}
          {{ section.settings.groom_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'wedding-card__character-image', alt: section.settings.groom_name | escape }}
        {% else %}
          <div class="wedding-card__character-placeholder">Groom</div>
        {% endif %}
      </div>
    </div>
    <div class="wedding-card__sequence" data-sequence aria-live="polite">
      <p class="wedding-card__sequence-text" data-sequence-text></p>
    </div>

    <div class="wedding-card__content" data-content>
      {% if section.settings.eyebrow != blank %}
        <p class="wedding-card__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      <div class="wedding-card__stepper" data-stepper>
        <div class="wedding-card__step is-active" data-step="names">
          <h2 class="wedding-card__title" data-names>{{ section.settings.bride_name }} <span>♥</span> {{ section.settings.groom_name }}</h2>
        </div>

        <div class="wedding-card__step" data-step="date">
          <p class="wedding-card__date{% if section.settings.wedding_date == blank %} wedding-card__date--hidden{% endif %}" data-date>{{ section.settings.date_label }} {{ section.settings.wedding_date }}</p>
        </div>

        <div class="wedding-card__step" data-step="message">
          <div class="wedding-card__message" data-message>
            {% if section.settings.message != blank %}
              {{ section.settings.message }}
            {% else %}
              <p></p>
            {% endif %}
          </div>
        </div>

        <div class="wedding-card__step" data-step="location">
          <div class="wedding-card__actions">
            <a class="wedding-card__button wedding-card__button--primary{% if section.settings.location_url == blank %} wedding-card__button--hidden{% endif %}" href="{{ section.settings.location_url }}" target="_blank" rel="noopener noreferrer" data-location>
              📍 <span data-location-label>{{ section.settings.location_label }}</span>
            </a>
          </div>
        </div>
      </div>

      <div class="wedding-card__replay-wrap">
        <button class="wedding-card__button wedding-card__button--ghost" type="button" data-replay>
          Replay Animation
        </button>
      </div>

      {% if section.settings.footer_text != blank %}
        <p class="wedding-card__footer">{{ section.settings.footer_text }}</p>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #wedding-card-{{ section.id }} {
    --card-bg: {{ section.settings.card_background }};
    --card-border: {{ section.settings.card_border }};
    --accent: {{ section.settings.accent_color }};
    --accent-strong: {{ section.settings.accent_strong_color }};
    --petal-start: {{ section.settings.petal_color_start }};
    --petal-end: {{ section.settings.petal_color_end }};
    --text-main: {{ section.settings.text_color }};
    --text-soft: {{ section.settings.text_soft_color }};
    --curtain-base: {{ section.settings.curtain_color }};
    --curtain-shadow: {{ section.settings.curtain_shadow_color }};
    --curtain-open-duration: 1800ms;
    --curtain-luxe-ease: cubic-bezier(.16, .84, .18, .99);
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10000;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    color: var(--text-main);
    background:
      radial-gradient(circle at top, rgba(255, 198, 214, 0.16), transparent 24%),
      radial-gradient(circle at bottom, rgba(255, 218, 138, 0.18), transparent 26%),
      linear-gradient(180deg, {{ section.settings.background_top }} 0%, {{ section.settings.background_mid }} 48%, {{ section.settings.background_bottom }} 100%);
  }

  #wedding-card-{{ section.id }} *,
  #wedding-card-{{ section.id }} *::before,
  #wedding-card-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #wedding-card-{{ section.id }} .wedding-card__intro {
    position: absolute;
    inset: 0;
    z-index: 12;
    display: grid;
    place-content: center;
    gap: 14px;
    text-align: center;
    padding: 28px;
    background: linear-gradient(180deg, rgba(15, 2, 6, 0.82), rgba(37, 0, 13, 0.86));
    transition: opacity .5s ease, visibility .5s ease;
  }

  #wedding-card-{{ section.id }} .wedding-card__intro.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  #wedding-card-{{ section.id }} .wedding-card__intro-kicker {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: .2em;
    font-size: .72rem;
    color: #ffdca8;
  }

  #wedding-card-{{ section.id }} .wedding-card__intro-title {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(1.7rem, 6vw, 2.8rem);
    font-family: Georgia, "Times New Roman", serif;
    color: #fff1f3;
  }

  #wedding-card-{{ section.id }} .wedding-card__scene {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 3vw, 40px);
    opacity: 0;
    pointer-events: none;
    transition: opacity .55s ease;
  }

  #wedding-card-{{ section.id }}.is-open .wedding-card__scene {
    opacity: 1;
    pointer-events: auto;
  }

  #wedding-card-{{ section.id }} .wedding-card__backdrop,
#wedding-card-{{ section.id }} .wedding-card__particles,
  #wedding-card-{{ section.id }} .wedding-card__spotlight,
  #wedding-card-{{ section.id }} .wedding-card__stage,
  #wedding-card-{{ section.id }} .wedding-card__petals,
  #wedding-card-{{ section.id }} .wedding-card__characters,
  #wedding-card-{{ section.id }} .wedding-card__curtains {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  #wedding-card-{{ section.id }} .wedding-card__curtain {
    position: absolute;
    top: 0;
    width: 50.5%;
    height: 100%;
    background:
      radial-gradient(120% 92% at 12% 50%, rgba(255, 242, 248, .22), transparent 46%),
      radial-gradient(85% 84% at 84% 52%, rgba(87, 1, 31, .24), transparent 68%),
      linear-gradient(103deg, #57001f 0%, #7f1138 34%, #cf5f8f 72%, #ffd5e8 100%),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.07) 0 14px, rgba(53,0,20,0.11) 14px 30px);
    box-shadow:
      inset -22px 0 30px rgba(0, 0, 0, 0.24),
      inset 0 0 42px rgba(255, 190, 225, 0.15),
      0 0 26px rgba(0, 0, 0, 0.2);
    border-radius: 0 18px 18px 0 / 0 40px 40px 0;
    clip-path: ellipse(108% 108% at 0% 50%);
    will-change: transform;
  }

  #wedding-card-{{ section.id }} .wedding-card__curtain--left { left: 0; }
  #wedding-card-{{ section.id }} .wedding-card__curtain--right {
    right: 0;
    border-radius: 18px 0 0 18px / 40px 0 0 40px;
    clip-path: ellipse(108% 108% at 100% 50%);
    background:
      radial-gradient(120% 92% at 88% 50%, rgba(255, 242, 248, .2), transparent 46%),
      radial-gradient(85% 84% at 16% 52%, rgba(87, 1, 31, .24), transparent 68%),
      linear-gradient(257deg, #57001f 0%, #7f1138 34%, #cf5f8f 72%, #ffd5e8 100%),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.07) 0 14px, rgba(53,0,20,0.11) 14px 30px);
    box-shadow:
      inset 22px 0 30px rgba(0, 0, 0, 0.24),
      inset 0 0 42px rgba(255, 190, 225, 0.15),
      0 0 26px rgba(0, 0, 0, 0.2);
  }

  #wedding-card-{{ section.id }}.is-opening .wedding-card__curtain--left {
    animation: wedding-card-open-left-{{ section.id }} var(--curtain-open-duration) forwards var(--curtain-luxe-ease);
  }

  #wedding-card-{{ section.id }}.is-opening .wedding-card__curtain--right {
    animation: wedding-card-open-right-{{ section.id }} var(--curtain-open-duration) forwards var(--curtain-luxe-ease);
  }

  #wedding-card-{{ section.id }} .wedding-card__particles {
    width: 100%;
    height: 100%;
    opacity: .55;
  }

  #wedding-card-{{ section.id }} .wedding-card__backdrop::before,
  #wedding-card-{{ section.id }} .wedding-card__backdrop::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    filter: blur(20px);
    opacity: 0.55;
  }

  #wedding-card-{{ section.id }} .wedding-card__backdrop::before {
    width: min(40vw, 420px);
    height: min(40vw, 420px);
    top: 10%;
    left: 8%;
    background: radial-gradient(circle, rgba(255,255,255,0.2), transparent 68%);
    animation: wedding-card-float-{{ section.id }} 9s ease-in-out infinite alternate;
  }

  #wedding-card-{{ section.id }} .wedding-card__backdrop::after {
    width: min(34vw, 360px);
    height: min(34vw, 360px);
    right: 8%;
    top: 12%;
    background: radial-gradient(circle, rgba(255, 206, 153, 0.22), transparent 70%);
    animation: wedding-card-float-{{ section.id }} 11s ease-in-out infinite alternate-reverse;
  }

  #wedding-card-{{ section.id }} .wedding-card__spotlight {
    inset: auto 50% 18%;
    width: min(90vw, 980px);
    height: min(72vh, 720px);
    transform: translateX(-50%);
    background: radial-gradient(circle at center, rgba(255, 236, 194, 0.28), rgba(255, 236, 194, 0.1) 28%, transparent 62%);
    filter: blur(4px);
  }

  #wedding-card-{{ section.id }} .wedding-card__stage {
    inset: auto 50% 0;
    width: min(1000px, 92vw);
    height: 30vh;
    transform: translateX(-50%);
    background: radial-gradient(circle at center, rgba(255, 220, 168, 0.38), rgba(255, 220, 168, 0.08) 35%, transparent 74%);
  }

  #wedding-card-{{ section.id }} .wedding-card__petal {
    position: absolute;
    top: -12vh;
    left: var(--left);
    width: var(--size);
    height: calc(var(--size) * .74);
    border-radius: 70% 0 70% 0;
    opacity: 0;
    background:
      radial-gradient(circle at 30% 30%, rgba(255,255,255,.9), rgba(255,255,255,.18) 24%, transparent 38%),
      linear-gradient(135deg, var(--petal-start), var(--petal-end));
    box-shadow: 0 0 16px rgba(255, 96, 149, 0.2);
    animation: wedding-card-petal-fall-{{ section.id }} var(--duration) linear forwards;
    animation-delay: var(--delay);
  }

  #wedding-card-{{ section.id }} .wedding-card__characters {
    inset: auto 0 0;
    height: min(58vh, 600px);
  }
  #wedding-card-{{ section.id }} .wedding-card__sequence {
    position: absolute;
    z-index: 3;
    inset: 18% 5% auto;
    display: grid;
    justify-items: center;
    text-align: center;
    pointer-events: none;
    transition: opacity .45s ease;
  }

  #wedding-card-{{ section.id }} .wedding-card__sequence.is-hidden {
    opacity: 0;
  }

  #wedding-card-{{ section.id }} .wedding-card__sequence-text {
    margin: 0;
    max-width: 24ch;
    font-size: clamp(1.7rem, 5.2vw, 3.6rem);
    font-weight: 700;
    line-height: 1.18;
    color: #fff9fd;
    text-shadow: 0 8px 28px rgba(0,0,0,.78);
    letter-spacing: .03em;
  }


  #wedding-card-{{ section.id }} .wedding-card__character {
    position: absolute;
    bottom: 0;
    width: clamp(180px, 22vw, 300px);
    aspect-ratio: 0.66;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    filter: drop-shadow(0 26px 36px rgba(0,0,0,.38));
    opacity: 0;
  }

  #wedding-card-{{ section.id }} .wedding-card__character--bride { left: clamp(4%, 8vw, 15%); }
  #wedding-card-{{ section.id }} .wedding-card__character--groom { right: clamp(4%, 8vw, 15%); }

  #wedding-card-{{ section.id }}.is-open .wedding-card__character--bride {
    animation: wedding-card-bride-in-{{ section.id }} 1.9s .6s forwards cubic-bezier(.2, .8, .2, 1);
  }

  #wedding-card-{{ section.id }}.is-open .wedding-card__character--groom {
    animation: wedding-card-groom-in-{{ section.id }} 1.9s .6s forwards cubic-bezier(.2, .8, .2, 1);
  }

  #wedding-card-{{ section.id }} .wedding-card__character-image,
  #wedding-card-{{ section.id }} .wedding-card__character-placeholder {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
  }

  #wedding-card-{{ section.id }} .wedding-card__character-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 28px;
    border: 1px dashed rgba(255,255,255,.28);
    background: rgba(255,255,255,.08);
    color: var(--text-soft);
    text-transform: uppercase;
  }

  #wedding-card-{{ section.id }} .wedding-card__content {
    position: relative;
    z-index: 2;
    width: min(560px, 92vw);
    margin: 0 auto;
    padding: clamp(28px, 3.5vw, 42px);
    border-radius: 32px;
    text-align: center;
    background: linear-gradient(180deg, color-mix(in srgb, var(--card-bg) 72%, #050205 28%), color-mix(in srgb, var(--card-bg) 84%, #090307 16%));
    border: 1px solid color-mix(in srgb, var(--card-border) 62%, #fff 38%);
    backdrop-filter: blur(20px);
    box-shadow: 0 24px 70px rgba(0,0,0,.35);
    color: #fff7fb;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity .5s ease, transform .5s ease;
    pointer-events: none;
  }

  #wedding-card-{{ section.id }} .wedding-card__content.is-ready {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  #wedding-card-{{ section.id }} .wedding-card__stepper {
    display: grid;
    gap: 0px;
    min-height: 163px;
    margin-bottom: 12px;
  }

  #wedding-card-{{ section.id }} .wedding-card__step {
    display: none;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity .55s ease, transform .55s ease;
  }

  #wedding-card-{{ section.id }} .wedding-card__step.is-visible {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  #wedding-card-{{ section.id }} .wedding-card__step.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  #wedding-card-{{ section.id }} .wedding-card__step.is-cinematic-in {
    animation: wedding-card-step-fade-{{ section.id }} .95s ease forwards;
  }


  #wedding-card-{{ section.id }} .wedding-card__eyebrow {
    margin: 0 auto 16px;
    display: inline-flex;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(255, 215, 162, .1);
    color: #ffe4af;
    border: 1px solid rgba(255,255,255,.12);
    letter-spacing: .14em;
    text-transform: uppercase;
    font-size: .72rem;
    font-weight: 600;
  }

  #wedding-card-{{ section.id }} .wedding-card__title {
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 4.4rem);
    line-height: .94;
    font-family: Georgia, "Times New Roman", serif;
  }

  #wedding-card-{{ section.id }} .wedding-card__title span { color: var(--accent); }

  #wedding-card-{{ section.id }} .wedding-card__message {
    color: #fff0f6;
    line-height: 1.8;
    margin: 0 auto;
    max-width: 34ch;
    font-size: 1.02rem;
  }

  #wedding-card-{{ section.id }} .wedding-card__message p { margin: 0; }

  #wedding-card-{{ section.id }} .wedding-card__date {
    margin: 0;
    font-size: .98rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #ffe4af;
    font-weight: 700;
  }

  #wedding-card-{{ section.id }} .wedding-card__actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  #wedding-card-{{ section.id }} .wedding-card__replay-wrap {
    display: flex;
    justify-content: center;
    margin-top: 8px;
  }

  #wedding-card-{{ section.id }} .wedding-card__button {
    appearance: none;
    border: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 190px;
    padding: 14px 22px;
    border-radius: 999px;
    text-decoration: none;
    font-size: .95rem;
    font-weight: 600;
    transition: transform .3s ease, box-shadow .3s ease;
  }

  #wedding-card-{{ section.id }} .wedding-card__button:hover { transform: translateY(-2px); }

  #wedding-card-{{ section.id }} .wedding-card__button--primary {
    color: #2d0d12;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    box-shadow: 0 14px 30px rgba(255, 203, 116, .26);
  }

  #wedding-card-{{ section.id }} .wedding-card__button--ghost {
    color: #fff6f9;
    background: rgba(255,255,255,.12);
    border: 1px solid rgba(255,255,255,.32);
  }

  #wedding-card-{{ section.id }} .wedding-card__button--hidden,
  #wedding-card-{{ section.id }} .wedding-card__date--hidden { display: none; }

  #wedding-card-{{ section.id }} .wedding-card__footer {
    margin: 22px 0 0;
    font-size: .82rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text-main) 65%, transparent 35%);
  }

  @keyframes wedding-card-open-left-{{ section.id }} { to { transform: translateX(-108%); } }
  @keyframes wedding-card-open-right-{{ section.id }} { to { transform: translateX(108%); } }
  @keyframes wedding-card-step-fade-{{ section.id }} {
    0% { opacity: 0; transform: translateY(20px) scale(.985); filter: blur(2px); }
    100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
  }
  @keyframes wedding-card-bride-in-{{ section.id }} {
    0% { opacity: 0; transform: translateX(-60vw) scale(.9); }
    100% { opacity: 1; transform: translateX(min(14vw, 90px)) scale(1); }
  }

  @keyframes wedding-card-groom-in-{{ section.id }} {
    0% { opacity: 0; transform: translateX(60vw) scale(.9); }
    100% { opacity: 1; transform: translateX(max(-14vw, -90px)) scale(1); }
  }

  @keyframes wedding-card-petal-fall-{{ section.id }} {
    0% { opacity: 0; transform: translate3d(0, -8vh, 0) rotate(0deg) scale(.86); }
    10% { opacity: .92; }
    100% { opacity: 0; transform: translate3d(var(--drift), 118vh, 0) rotate(var(--spin)) scale(1.08); }
  }

  @keyframes wedding-card-float-{{ section.id }} {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(18px, -22px, 0) scale(1.06); }
  }

  @media screen and (max-width: 749px) {
    #wedding-card-{{ section.id }} .wedding-card__scene { align-items: flex-start; padding-top: 40px; padding-bottom: 160px; }
    #wedding-card-{{ section.id }} .wedding-card__sequence { inset: 14% 6% auto; }
    #wedding-card-{{ section.id }} .wedding-card__sequence-text { font-size: clamp(1.45rem, 8vw, 2.6rem); }
    #wedding-card-{{ section.id }} .wedding-card__content { width: min(94vw, 480px); padding: 24px 18px; }
    #wedding-card-{{ section.id }} .wedding-card__actions { flex-direction: column; }
    #wedding-card-{{ section.id }} .wedding-card__button { width: 100%; }
    #wedding-card-{{ section.id }} .wedding-card__characters { height: min(38vh, 330px); }
    #wedding-card-{{ section.id }} .wedding-card__character { width: clamp(120px, 32vw, 180px); }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('wedding-card-{{ section.id }}');
    if (!root) return;

    const intro = root.querySelector('[data-intro]');
    const scene = root.querySelector('[data-scene]');
    const openButton = root.querySelector('[data-open-invitation]');
    const replayButton = root.querySelector('[data-replay]');
    const petalsHost = root.querySelector('[data-petals]');
    const particlesCanvas = root.querySelector('[data-particles]');
    const sequenceEl = root.querySelector('[data-sequence]');
    const sequenceTextEl = root.querySelector('[data-sequence-text]');
    const contentEl = root.querySelector('[data-content]');
    const namesEl = root.querySelector('[data-names]');
    const dateEl = root.querySelector('[data-date]');
    const messageEl = root.querySelector('[data-message]');
    const locationEl = root.querySelector('[data-location]');
    const locationLabelEl = root.querySelector('[data-location-label]');
    const inviterEl = root.querySelector('[data-inviter]');
    const stepEls = Array.from(root.querySelectorAll('[data-step]'));

    const params = new URLSearchParams(window.location.search);
    const stepTimers = [];
    let petalInterval;
    let particles = [];
    let particleState = null;
    const curtainOpenDuration = 1800;
    const sequenceDelays = {
      namesPause: 1000,
      datePause: 1000,
      messagePause: 3000
    };

    function decodeMessage(value) {
      if (!value) return '';
      try {
        return window.atob(value);
      } catch (error) {
        return value;
      }
    }

    function hydrateFromUrl() {
      const brideName = params.get('b') || root.dataset.brideName || '';
      const groomName = params.get('g') || root.dataset.groomName || '';
      const weddingDate = params.get('d') || root.dataset.weddingDate || '';
      const dateLabel = root.dataset.dateLabel || 'Wedding Date:';
      const locationUrl = params.get('l') || root.dataset.locationUrl || '';
      const locationLabel = params.get('ll') || root.dataset.locationLabel || 'View Location';
      const inviterName = params.get('i') || root.dataset.inviterName || 'Saurabh';
      const customMessage = decodeMessage(params.get('m')) || messageEl?.textContent?.trim() || '';

      if (inviterEl) inviterEl.textContent = inviterName;
      if (namesEl) namesEl.innerHTML = `${brideName} <span>♥</span> ${groomName}`.trim();

      if (messageEl && customMessage) {
        const messageParagraph = messageEl.querySelector('p') || document.createElement('p');
        messageParagraph.textContent = customMessage;
        if (!messageParagraph.parentNode) messageEl.appendChild(messageParagraph);
      }

      if (dateEl) {
        const hasDate = Boolean(weddingDate);
        dateEl.textContent = hasDate ? `${dateLabel} ${weddingDate}` : '';
        dateEl.classList.toggle('wedding-card__date--hidden', !hasDate);
        dateEl.closest('[data-step]')?.toggleAttribute('data-disabled', !hasDate);
      }

      if (locationEl && locationLabelEl) {
        if (locationUrl) {
          locationEl.href = locationUrl;
          locationLabelEl.textContent = locationLabel;
          locationEl.classList.remove('wedding-card__button--hidden');
          locationEl.closest('[data-step]')?.removeAttribute('data-disabled');
        } else {
          locationEl.classList.add('wedding-card__button--hidden');
          locationEl.closest('[data-step]')?.setAttribute('data-disabled', 'true');
        }
      }

      if (!customMessage) {
        messageEl?.closest('[data-step]')?.setAttribute('data-disabled', 'true');
      } else {
        messageEl?.closest('[data-step]')?.removeAttribute('data-disabled');
      }
    }

    function createPetal() {
      const petal = document.createElement('span');
      petal.className = 'wedding-card__petal';
      petal.style.setProperty('--left', `${Math.random() * 100}%`);
      petal.style.setProperty('--size', `${12 + Math.random() * 16}px`);
      petal.style.setProperty('--duration', `${5.2 + Math.random() * 2.8}s`);
      petal.style.setProperty('--delay', `${Math.random() * 0.4}s`);
      petal.style.setProperty('--drift', `${-160 + Math.random() * 320}px`);
      petal.style.setProperty('--spin', `${-220 + Math.random() * 440}deg`);
      petalsHost.appendChild(petal);
      window.setTimeout(() => petal.remove(), 9000);
    }

    function startPetals() {
      window.clearInterval(petalInterval);
      petalsHost.innerHTML = '';
      petalInterval = window.setInterval(() => {
        createPetal();
        if (Math.random() > 0.45) createPetal();
      }, 190);
    }

    function clearStepTimers() {
      while (stepTimers.length) {
        window.clearTimeout(stepTimers.pop());
      }
    }

   function setupParticles() {
      if (!particlesCanvas) return;
      const context = particlesCanvas.getContext('2d', { alpha: true });
      if (!context) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const state = {
        ctx: context,
        dpr: 1,
        width: 0,
        height: 0,
        count: reduceMotion ? 10 : Math.min(28, Math.max(14, Math.floor(window.innerWidth / 44))),
        lastTime: 0
      };
      particleState = state;

      function makeParticle() {
        return {
          x: Math.random() * state.width,
          y: Math.random() * state.height,
          size: 0.8 + Math.random() * 2.2,
          speedY: 0.08 + Math.random() * 0.24,
          drift: -0.08 + Math.random() * 0.16,
          alpha: 0.1 + Math.random() * 0.45,
          phase: Math.random() * Math.PI * 2,
          twinkle: 0.18 + Math.random() * 0.55
        };
      }

      function resizeParticles() {
        state.dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        state.width = particlesCanvas.clientWidth || root.clientWidth;
        state.height = particlesCanvas.clientHeight || root.clientHeight;
        particlesCanvas.width = Math.max(1, Math.floor(state.width * state.dpr));
        particlesCanvas.height = Math.max(1, Math.floor(state.height * state.dpr));
        state.ctx.setTransform(state.dpr, 0, 0, state.dpr, 0, 0);
        particles = Array.from({ length: state.count }, makeParticle);
      }

      function tick(now) {
        if (!particleState) return;
        const dt = Math.min(32, now - (state.lastTime || now));
        state.lastTime = now;
        state.ctx.clearRect(0, 0, state.width, state.height);

        for (let i = 0; i < particles.length; i += 1) {
          const particle = particles[i];
          particle.y -= particle.speedY * (dt / 16);
          particle.x += particle.drift * (dt / 16);
          particle.phase += particle.twinkle * 0.016;

          if (particle.y < -12 || particle.x < -12 || particle.x > state.width + 12) {
            particles[i] = {
              ...makeParticle(),
              x: Math.random() * state.width,
              y: state.height + Math.random() * 26
            };
            continue;
          }

          const shimmer = (Math.sin(particle.phase) + 1) / 2;
          state.ctx.beginPath();
          state.ctx.fillStyle = `rgba(255, 241, 231, ${Math.max(0.06, particle.alpha * (0.52 + shimmer * 0.6))})`;
          state.ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
          state.ctx.fill();
        }

        window.requestAnimationFrame(tick);
      }

      resizeParticles();
      window.addEventListener('resize', resizeParticles, { passive: true });
      window.requestAnimationFrame(tick);
    }

    function getEnabledSteps() {
      return stepEls.filter((step) => !step.hasAttribute('data-disabled'));
    }

   function revealStep(step) {
      if (!step) return;
      step.classList.add('is-visible');
    }

    function showFinalCard(enabledSteps) {
      enabledSteps.forEach((step) => {
        revealStep(step);
        step.classList.add('is-active');
      });
      contentEl?.classList.add('is-ready');
      sequenceEl?.classList.add('is-hidden');
    }

    function runStepSequence() {
      clearStepTimers();
      const enabledSteps = getEnabledSteps();
      if (!enabledSteps.length) return;

 stepEls.forEach((step) => step.classList.remove('is-visible', 'is-active', 'is-cinematic-in'));
      stepEls.forEach((step) => step.classList.remove('is-visible', 'is-active'));
      contentEl?.classList.remove('is-ready');
      sequenceEl?.classList.remove('is-hidden');
      const namesStep = enabledSteps.find((step) => step.dataset.step === 'names');
      const dateStep = enabledSteps.find((step) => step.dataset.step === 'date');
      const messageStep = enabledSteps.find((step) => step.dataset.step === 'message');
      const namesText = namesEl?.textContent?.trim() || '';
      const dateText = dateEl?.textContent?.trim() || '';
      const messageText = messageEl?.textContent?.trim() || '';
      const sequenceQueue = [
        { text: namesText, pause: sequenceDelays.namesPause, step: namesStep },
        { text: dateText, pause: sequenceDelays.datePause, step: dateStep },
        { text: messageText, pause: sequenceDelays.messagePause, step: messageStep }
      ].filter((item) => item.text && item.step);

      if (!sequenceQueue.length) {
        showFinalCard(enabledSteps);
        return;
      }

      if (sequenceTextEl) sequenceTextEl.textContent = sequenceQueue[0].text;
      let elapsed = 0;
      sequenceQueue.forEach((item, index) => {
        if (index === 0) {
          revealStep(item.step);
 item.step.classList.add('is-cinematic-in');
          item.step.classList.add('is-active');
          elapsed += item.pause;
          return;
        }

        const timer = window.setTimeout(() => {
          if (sequenceTextEl) sequenceTextEl.textContent = item.text;
          revealStep(item.step);
 item.step.classList.remove('is-cinematic-in');
          item.step.classList.add('is-active');
        }, elapsed);
        stepTimers.push(timer);
        elapsed += item.pause;
      });

      const finalTimer = window.setTimeout(() => {
        showFinalCard(enabledSteps);
      }, elapsed);
      stepTimers.push(finalTimer);
    }

    function openInvitation() {
      intro?.classList.add('is-hidden');
      root.classList.remove('is-open');
      root.classList.add('is-opening');

      window.setTimeout(() => {
        root.classList.remove('is-opening');
        root.classList.add('is-open');
        runStepSequence();
        startPetals();
      }, curtainOpenDuration);
    }

    function replayAnimations() {
      runStepSequence();
      startPetals();
    }

    hydrateFromUrl();
setupParticles();
    scene?.setAttribute('aria-hidden', 'true');
    openButton?.addEventListener('click', () => {
      scene?.setAttribute('aria-hidden', 'false');
      openInvitation();
    });
    replayButton?.addEventListener('click', replayAnimations);
  })();
</script>

