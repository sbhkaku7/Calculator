    margin: 0 auto;
    padding: clamp(28px, 3.5vw, 42px);
    border-radius: 32px;
    text-align: center;
    background: linear-gradient(180deg, color-mix(in srgb, var(--card-bg) 88%, #fff 12%), color-mix(in srgb, var(--card-bg) 94%, transparent 6%));
    border: 1px solid var(--card-border);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 24px 70px rgba(0,0,0,.35);
    animation: wedding-card-content-in-{{ section.id }} 1.1s 3s both cubic-bezier(.2, .8, .2, 1);
